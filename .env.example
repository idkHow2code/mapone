# Copy to .env and fill in the values: cp .env.example .env

# MySQL
DB_NAME=event_registration
DB_USER=app
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root
DB_PORT=3306

# phpMyAdmin (http://localhost:8080)
PMA_PORT=8080

# OneMap API account (register at https://www.onemap.gov.sg/apidocs/register)
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Frontend origin allowed by the API (CORS)
CORS_ORIGIN=http://localhost:8001

# API URL baked into the frontend build
VITE_API_BASE_URL=http://localhost:8000

TZ=Asia/Singapore
